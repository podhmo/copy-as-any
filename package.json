{
    "name": "copy-as-any",
    "version": "1.0.0",
    "description": "browser extension, copy as any (e.g.  OGP card, markdown, JSON)",
    "main": "index.js",
    "scripts": {
        "lint": "web-ext lint --source-dir ./src",
        "build:firefox": "web-ext build --source-dir ./src --artifacts-dir ./dist --filename {name}-{version}-firefox.xpi --overwrite-dest",
        "build:chrome": "web-ext build --source-dir ./src --artifacts-dir ./dist --filename {name}-{version}-chrome.xpi --overwrite-dest",
        "build": "npm run lint && npm run build:firefox && npm run build:chrome"
    },
    "repository": {
        "type": "git",
        "url": "git+ssh://git@github.com/podhmo/copy-as-any.git"
    },
    "author": "",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/podhmo/copy-as-any/issues"
    },
    "homepage": "https://github.com/podhmo/copy-as-any#readme",
    "devDependencies": {
        "web-ext": "^10.0.0"
    }
}
