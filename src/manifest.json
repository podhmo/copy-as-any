{
    "manifest_version": 3,
    "name": "Copy as any",
    "version": "0.0.1",
    "description": "copy ogp info to clipboard as any style",
    "browser_specific_settings": {
        "gecko": {
            "id": "copy-as-any@podhmo",
            "strict_min_version": "140.0",
            "data_collection_permissions": {
                "required": ["none"],
                "optional": []
            }
        }
    },
    "background": {
        "scripts": ["background.js"],
        "service_worker": "background.js",
        "type": "module"
    },
    "action": {},
    "permissions": [
        "scripting",
        "activeTab",
        "tabs",
        "alarms",
        "clipboardWrite"
    ]
}
